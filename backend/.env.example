# Environment Configuration for Backend

# Server Configuration
PORT=3000

# Firebase Configuration
# Option 1: Use environment variables (recommended for Cloud Run)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"

# Option 2: Use service account file path
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Google Cloud Storage
GCS_BUCKET_NAME=petivolution-snapshots
GCS_SNAPSHOT_RETENTION_DAYS=7

# SSE Configuration
SSE_HEARTBEAT_INTERVAL_MS=30000
SSE_MAX_CLIENTS_PER_WORLD=100

# Note: For Cloud Run deployment, use environment variables (Option 1)
# For local development, you can use either option
